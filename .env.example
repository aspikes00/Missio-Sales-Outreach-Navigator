# LinkedIn Credentials (shared across all brands — one LinkedIn account)
LINKEDIN_EMAIL=you@example.com
LINKEDIN_PASSWORD=your_password_here

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-...

# Timing (seconds) — randomized between these bounds
MIN_DELAY_SECONDS=120
MAX_DELAY_SECONDS=600

# Business Hours (24h format, your local timezone)
BUSINESS_HOURS_START=9
BUSINESS_HOURS_END=17
TIMEZONE=America/Chicago

# Paths
DB_PATH=data/leads.db
COOKIES_PATH=data/cookies.json
LOG_PATH=logs/outreach.log

# AI Model
ANTHROPIC_MODEL=claude-sonnet-4-6

# Safety
HEADLESS_BROWSER=false
SESSION_WARMUP_DAYS=7
MAX_CONSECUTIVE_ERRORS=3

# ---------------------------------------------------------------------------
# Brand-specific settings (Calendly URL, Sales Nav list, CTA type, limits)
# are configured per-brand in brands/<slug>/brand.toml
# ---------------------------------------------------------------------------
